rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /spot_photos/{spotId}/{filename} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.size < 5 * 1024 * 1024
                    && (request.resource.contentType == 'image/jpeg' || request.resource.contentType == 'image/png')
                    && request.resource.metadata.ownerUid == request.auth.uid;
      // Allow updates ONLY by the original photo uploader (ownerUid check)
      allow update: if request.auth != null
                    && resource.metadata.ownerUid == request.auth.uid
                    && request.resource.size < 5 * 1024 * 1024
                    && (request.resource.contentType == 'image/jpeg' || request.resource.contentType == 'image/png')
                    && request.resource.metadata.ownerUid == request.auth.uid;
      allow delete: if request.auth != null && resource.metadata.ownerUid == request.auth.uid;
    }
  }
}
