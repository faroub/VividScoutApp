<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Include non-sensitive shared preferences for smooth UX restoration -->
    <include domain="sharedpref" path="."/>
    <!-- Exclude location-annotated Room database files from backup and restore -->
    <exclude domain="database" path="vivid_scout_database"/>
    <exclude domain="database" path="vivid_scout_database-wal"/>
    <exclude domain="database" path="vivid_scout_database-shm"/>
    <exclude domain="database" path="vivid_scout_database-shader"/>
</full-backup-content>
