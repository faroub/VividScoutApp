<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include non-sensitive shared preferences for smooth UX restoration -->
        <include domain="sharedpref" path="."/>
        <!-- Exclude location-annotated Room database files from cloud backup -->
        <exclude domain="database" path="vivid_scout_database"/>
        <exclude domain="database" path="vivid_scout_database-wal"/>
        <exclude domain="database" path="vivid_scout_database-shm"/>
        <exclude domain="database" path="vivid_scout_database-shader"/>
    </cloud-backup>
    <device-transfer>
        <!-- Include non-sensitive shared preferences for device-to-device transfer -->
        <include domain="sharedpref" path="."/>
        <!-- Exclude location-annotated Room database files from device-to-device transfer -->
        <exclude domain="database" path="vivid_scout_database"/>
        <exclude domain="database" path="vivid_scout_database-wal"/>
        <exclude domain="database" path="vivid_scout_database-shm"/>
        <exclude domain="database" path="vivid_scout_database-shader"/>
    </device-transfer>
</data-extraction-rules>
