<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="400dp"
    android:height="220dp"
    android:viewportWidth="400"
    android:viewportHeight="220">

    <!-- Deep Emerald Secret Gem Gradient -->
    <path android:pathData="M0,0h400v220h-400z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="200"
                android:startY="0"
                android:endX="200"
                android:endY="220"
                android:type="linear">
                <item android:color="#FF059669" android:offset="0.0" />
                <item android:color="#FF047857" android:offset="0.5" />
                <item android:color="#FF064E3B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sparkle Diamond Icon in Center -->
    <path
        android:pathData="M200,50 L230,110 L290,110 L240,145 L260,200 L200,165 L140,200 L160,145 L110,110 L170,110 Z"
        android:fillColor="#A7F3D0"
        android:fillAlpha="0.9" />

    <!-- Compass Ring Frame Overlay -->
    <path
        android:pathData="M200,110m-75,0a75,75 0 1,1 150,0a75,75 0 1,1 -150,0"
        android:strokeColor="#6EE7B7"
        android:strokeWidth="3"
        android:fillColor="#00000000" />
</vector>
