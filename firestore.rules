// Abuse prevention and data integrity rely on three layers, each enforcing different controls:
// - App Check: only the genuine app can invoke backend services. The callables enforce it in code (enforceAppCheck).
//   IMPORTANT: App Check enforcement for direct Firestore/Storage reads is a separate Firebase Console
//   toggle that is OFF by default and has NOT been enabled or verified for this project — these rules
//   cannot rely on it. Every read path here is additionally restricted by authentication/ownership rules.
// - These rules: authentication, per-owner access, schema/field validation, atomic vote/report accounting, immutability, and shared-trip expiry.
// - Cloud Functions (Admin SDK): the only writers of community tips/submissions, shared trips, and photo metadata — server-side per-UID rate limiting (including 24-hour community post limits), non-anonymous sign-in enforcement for reports, the ownership index that lets the rules enforce ownership without publishing UIDs, trusted photo registration with real image-byte validation, idempotent shared-trip publishing, and moderation/cleanup (soft-hide at the report threshold, reaping of unregistered uploads).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(ownerUid) {
      return isAuthenticated() && request.auth.uid == ownerUid;
    }

    // The owner of a public community document (community_tips, community_submissions,
    // spot_photos): those documents carry NO ownerUid, because anonymous Firebase UIDs
    // are stable identifiers and publishing them would let anyone link one person's
    // contributions across every public collection. Ownership is recorded instead in the
    // server-written ownership index (functions/ownershipIndex.js; written only by the
    // trusted callables, whose Admin SDK writes bypass these rules). This function reads
    // the index through the rules get()/exists() functions, which bypass the referenced
    // document's read permission (verified against the Firestore emulator), so the index
    // stays client-unreadable while ownership is still enforced here, at the trusted
    // boundary. A missing index record fails closed for every caller.
    //
    // Legacy documents written before the index existed still carry ownerUid; they keep
    // validating against their own field until their owner replays them through a
    // callable, which backfills their index record. The ternary below selects the
    // authoritative source — only the taken branch is evaluated, so the absent field on
    // a new document never errors.
    function communityOwnerUid(collectionId, docId, data) {
      return exists(/databases/$(database)/documents/ownership_index/$(collectionId)/records/$(docId))
             ? get(/databases/$(database)/documents/ownership_index/$(collectionId)/records/$(docId)).data.ownerUid
             : data.ownerUid;
    }

    function isValidCoordinates(lat, lng) {
      return lat >= -90.0 && lat <= 90.0 && lng >= -180.0 && lng <= 180.0;
    }

    function isValidPhotoUri(uri) {
      // An empty string means "no photo". Any actual photo must be a Storage object
      // path under the signed-in user's own ownership-aware directory
      // (spot_photos/{uid}/{spotId}/{filename}). An external https:// URL is rejected:
      // every viewer's device would fetch a third-party host, exposing their IP
      // address and allowing cross-user tracking.
      return uri is string && (uri == '' ||
        (uri.size() < 2048 && uri.matches('^spot_photos/' + request.auth.uid + '/[^/]+/[^/]+$')));
    }

    match /community_submissions/{submissionId} {
      // Public read: submissions are community content. They must NEVER contain
      // private scout notes — Firestore has no field-level access control, so any
      // field here is world-readable. Private notes live under
      // users/{uid}/private_spot_notes/{spotId} (see below) and may not be written
      // into this collection.
      allow read: if true;

      // Creation is only permitted through the trusted submitCommunitySpot Cloud
      // Function, whose Admin SDK writes bypass these rules: it validates the payload
      // strictly (and the 24-hour per-UID submission limit server-side) and records
      // ownership in the server-written ownership index instead of publishing the
      // author's UID in this publicly readable document.
      allow create: if false;

      // Atomic report increment: the direct-write parity path for community reporting
      // (the reportCommunitySubmission callable is the primary path, enforced with
      // non-anonymous sign-in and a per-UID rate limit the rules cannot express). Same
      // invariants as the community_tips report branch above: the counter changes by
      // exactly one (creating it on documents that predate community reporting), the
      // reporter's report document must not exist before and must exist after, and the
      // submission's owner may never report their own content.
      allow update: if isAuthenticated()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportsCount'])
                    && request.resource.data.reportsCount is number
                    && (resource.data.keys().hasAny(['reportsCount'])
                         ? request.resource.data.reportsCount == resource.data.reportsCount + 1
                         : request.resource.data.reportsCount == 1)
                    && request.auth.uid != communityOwnerUid('community_submissions', submissionId, resource.data)
                    && !exists(/databases/$(database)/documents/community_submissions/$(submissionId)/reports/$(request.auth.uid))
                    && existsAfter(/databases/$(database)/documents/community_submissions/$(submissionId)/reports/$(request.auth.uid));

      // The owner of a submission may edit exactly the client-controlled fields the
      // submitCommunitySpot callable accepts — reportsCount, moderationState and
      // moderatedAt are server-owned and must never be client-writable.
      allow update: if isOwner(communityOwnerUid('community_submissions', submissionId, resource.data))
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'id', 'title', 'description', 'category', 'locationName',
                         'latitude', 'longitude', 'photoUri', 'contributor', 'timestamp'
                       ])
                    && request.resource.data.title is string
                    && request.resource.data.title.size() >= 2
                    && request.resource.data.title.size() <= 120
                    && request.resource.data.category is string
                    && request.resource.data.category.size() <= 32
                    && request.resource.data.id is string
                    && request.resource.data.id.size() <= 128
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 1000
                    && request.resource.data.locationName is string
                    && request.resource.data.locationName.size() <= 100
                    && request.resource.data.contributor is string
                    && request.resource.data.contributor.size() >= 1
                    && request.resource.data.contributor.size() <= 50
                    && request.resource.data.latitude is number
                    && request.resource.data.longitude is number
                    && isValidCoordinates(request.resource.data.latitude, request.resource.data.longitude)
                    && isValidPhotoUri(request.resource.data.photoUri)
                    && request.resource.data.timestamp is number
                    // A SET timestamp must be dated within the window: at most 5 minutes
                    // in the future (clock skew) and no older than 30 days (offline
                    // drafts may legitimately be older than a fresh post). The bound
                    // applies only when the update changes the field, so documents with
                    // already-committed old timestamps stay editable. Mirrors the
                    // callable's window in functions/community.js.
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['timestamp'])
                        || (request.resource.data.timestamp <= request.time.toMillis() + 300000
                            && request.resource.data.timestamp >= request.time.toMillis() - 2592000000));

      allow delete: if false;

      // Per-account unique report tracking subcollection: report document ID = user UID.
      // A report document may ONLY be created as part of the atomic transaction that
      // increments the parent submission's reportsCount counter (see the report update
      // rule above). Reporter UIDs are never exposed to anyone; the submission's owner
      // may never report their own content.
      match /reports/{userId} {
        allow read: if false; // Reporter UIDs are never exposed to anyone
        allow create: if isAuthenticated()
                      && userId == request.auth.uid
                      && request.resource.data.keys().hasOnly(['reporterUid', 'timestamp'])
                      && request.resource.data.reporterUid == request.auth.uid
                      && request.resource.data.timestamp is number
                      && (get(/databases/$(database)/documents/community_submissions/$(submissionId)).data.keys().hasAny(['reportsCount'])
                           ? getAfter(/databases/$(database)/documents/community_submissions/$(submissionId)).data.reportsCount
                                == get(/databases/$(database)/documents/community_submissions/$(submissionId)).data.reportsCount + 1
                           : getAfter(/databases/$(database)/documents/community_submissions/$(submissionId)).data.reportsCount == 1)
                      && !exists(/databases/$(database)/documents/community_submissions/$(submissionId)/reports/$(userId))
                      && existsAfter(/databases/$(database)/documents/community_submissions/$(submissionId)/reports/$(userId))
                      && request.auth.uid != communityOwnerUid('community_submissions', submissionId, get(/databases/$(database)/documents/community_submissions/$(submissionId)).data);
        allow update, delete: if false; // Immutable report records
      }
    }

    // Private scout notes: one document per spot per user, scoped under the owner's
    // own UID path. Only the authenticated owner can read, create, update, or delete
    // their own notes; the collection path key ({uid}) is the authoritative identity,
    // so no client can read, enumerate, overwrite, or delete another user's notes, and
    // the owner identity inside each document may never be changed.
    match /users/{uid}/private_spot_notes/{spotId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
                    && request.resource.data.keys().hasOnly(['spotId', 'ownerUid', 'notes', 'updatedAt'])
                    && request.resource.data.spotId is string
                    && request.resource.data.spotId.size() <= 128
                    && request.resource.data.ownerUid == uid
                    && request.resource.data.notes is string
                    && request.resource.data.notes.size() <= 2000
                    && request.resource.data.updatedAt is number;
      allow update: if isOwner(uid)
                    && request.resource.data.keys().hasOnly(['spotId', 'ownerUid', 'notes', 'updatedAt'])
                    && request.resource.data.spotId is string
                    && request.resource.data.spotId.size() <= 128
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.ownerUid == uid
                    && request.resource.data.notes is string
                    && request.resource.data.notes.size() <= 2000
                    && request.resource.data.updatedAt is number;
      allow delete: if isOwner(uid);
    }

    match /community_tips/{tipId} {
      allow read: if true;

      function isValidTipData(data) {
        // 'ownerUid' is tolerated here ONLY because documents written before the
        // ownership index existed still carry it: this validator sees the full
        // post-write document. It may never be introduced or changed — the update
        // branch's affectedKeys().hasOnly() check (without 'ownerUid') forbids that —
        // and the trusted callable never writes it.
        return data.keys().hasOnly([
                 'id', 'ownerUid', 'spotId', 'spotTitle', 'authorName', 'content',
                 'timestamp', 'isStatusUpdate', 'statusCategory', 'legacyUpvotes', 'upvotes'
               ])
            && data.id is string && data.id.size() <= 128
            && data.spotId is string && data.spotId.size() <= 128
            && data.spotTitle is string && data.spotTitle.size() >= 2 && data.spotTitle.size() <= 120
            && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 50
            && data.content is string && data.content.size() >= 2 && data.content.size() <= 500
            && data.statusCategory is string && data.statusCategory.size() >= 2 && data.statusCategory.size() <= 32
            && data.isStatusUpdate is bool
            && data.timestamp is number
            && data.legacyUpvotes is number && data.legacyUpvotes >= 0 && data.legacyUpvotes <= 1000000
            && data.upvotes is number && data.upvotes >= 0 && data.upvotes <= 1000000;
      }

      // Creation is only permitted through the trusted postCommunityTip Cloud
      // Function, whose Admin SDK writes bypass these rules: it validates the payload
      // strictly, sets the upvotes counter server-side, enforces the 24-hour per-UID
      // tip limit, and records ownership in the server-written ownership index instead
      // of publishing the author's UID in this publicly readable document.
      allow create: if false;

      // Atomic upvote increment: requires vote doc NOT to exist before operation, and TO exist after operation.
      // Pre-write (!exists) + Post-write (existsAfter) prevents re-using pre-existing vote docs for replay increments.
      // The tip owner may never upvote their own tip: a self-vote is a fabricated
      // community signal, so the incrementer must be a different authenticated user.
      // Ownership is read from the ownership index (communityOwnerUid), never from a
      // public field — the document carries no ownerUid.
      allow update: if isAuthenticated() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes'])
         && request.resource.data.upvotes == resource.data.upvotes + 1
         && request.auth.uid != communityOwnerUid('community_tips', tipId, resource.data)
         && !exists(/databases/$(database)/documents/community_tips/$(tipId)/votes/$(request.auth.uid))
         && existsAfter(/databases/$(database)/documents/community_tips/$(tipId)/votes/$(request.auth.uid))) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportsCount'])
         && request.resource.data.reportsCount is number
         // Legacy documents written before community reporting carry no reportsCount:
         // the first report CREATES the counter (1), later reports increment by one.
         && (resource.data.keys().hasAny(['reportsCount'])
              ? request.resource.data.reportsCount == resource.data.reportsCount + 1
              : request.resource.data.reportsCount == 1)
         // The tip's owner may never report their own content: owners edit or delete
         // instead of flagging themselves.
         && request.auth.uid != communityOwnerUid('community_tips', tipId, resource.data)
         && !exists(/databases/$(database)/documents/community_tips/$(tipId)/reports/$(request.auth.uid))
         && existsAfter(/databases/$(database)/documents/community_tips/$(tipId)/reports/$(request.auth.uid))) ||
        (isOwner(communityOwnerUid('community_tips', tipId, resource.data))
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'id', 'spotId', 'spotTitle', 'authorName', 'content',
              'timestamp', 'isStatusUpdate', 'statusCategory', 'legacyUpvotes', 'upvotes'
            ])
         && isValidTipData(request.resource.data)
         && request.resource.data.upvotes == resource.data.upvotes
         && request.resource.data.legacyUpvotes == resource.data.legacyUpvotes
         // Same timestamp window as community_submissions, applied only when the update
         // sets the field (documents with already-committed old timestamps stay editable).
         && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['timestamp'])
             || (request.resource.data.timestamp <= request.time.toMillis() + 300000
                 && request.resource.data.timestamp >= request.time.toMillis() - 2592000000)))
      );

      allow delete: if false;

      // Per-account unique vote tracking subcollection: a user may read only their own vote
      // document. A vote document may ONLY be created as part of the atomic transaction that
      // increments the parent tip's upvotes counter (see the parent update rule): the parent
      // tip must exist before the operation, its upvotes counter must increase by exactly one
      // in this transaction, and the user's own vote document must not exist before it must
      // exist after it (per-user ID restrictions and immutability are preserved below).
      match /votes/{userId} {
        allow read: if isAuthenticated() && userId == request.auth.uid;
        allow create: if isAuthenticated()
                      && userId == request.auth.uid
                      && request.resource.data.keys().hasOnly(['uid', 'timestamp'])
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.timestamp is number
                      && get(/databases/$(database)/documents/community_tips/$(tipId)).data.upvotes is number
                      && getAfter(/databases/$(database)/documents/community_tips/$(tipId)).data.upvotes
                           == get(/databases/$(database)/documents/community_tips/$(tipId)).data.upvotes + 1
                      && !exists(/databases/$(database)/documents/community_tips/$(tipId)/votes/$(userId))
                      && existsAfter(/databases/$(database)/documents/community_tips/$(tipId)/votes/$(userId));
        allow update, delete: if false; // Immutable vote records
      }

      // Per-account unique report tracking subcollection: report document ID = user UID.
      // A report document may ONLY be created as part of the atomic transaction that
      // increments the parent tip's reportsCount counter (see the parent update rule):
      // the parent tip must exist before the operation, its reportsCount must increase
      // by exactly one in this transaction (creating the counter when the document
      // predates community reporting), and the user's own report document must not exist
      // before it and must exist after it. The tip's owner may never report their own
      // content. Reporter UIDs are never exposed to anyone.
      match /reports/{userId} {
        allow read: if false; // Reporter UIDs are never exposed to anyone
        allow create: if isAuthenticated()
                      && userId == request.auth.uid
                      && request.resource.data.keys().hasOnly(['reporterUid', 'timestamp'])
                      && request.resource.data.reporterUid == request.auth.uid
                      && request.resource.data.timestamp is number
                      && (get(/databases/$(database)/documents/community_tips/$(tipId)).data.keys().hasAny(['reportsCount'])
                           ? getAfter(/databases/$(database)/documents/community_tips/$(tipId)).data.reportsCount
                                == get(/databases/$(database)/documents/community_tips/$(tipId)).data.reportsCount + 1
                           : getAfter(/databases/$(database)/documents/community_tips/$(tipId)).data.reportsCount == 1)
                      && !exists(/databases/$(database)/documents/community_tips/$(tipId)/reports/$(userId))
                      && existsAfter(/databases/$(database)/documents/community_tips/$(tipId)/reports/$(userId))
                      && request.auth.uid != communityOwnerUid('community_tips', tipId, get(/databases/$(database)/documents/community_tips/$(tipId)).data);
        allow update, delete: if false; // Immutable report records
      }
    }

    match /spot_photos/{photoId} {
      allow read: if true;

      // Photo metadata documents are created ONLY by the trusted finalizePhotoUpload
      // Cloud Function (its Admin SDK writes bypass rules). The function verifies that
      // the referenced Storage object exists in the project bucket, lives under the
      // authenticated caller's own ownership-aware path, is within the size limit, and
      // is a permitted image type, and generates the document id server-side. Direct
      // client creation is denied so an arbitrary external URL can never become a photo.
      allow create: if false;

      // Atomic photo report increment: requires report doc NOT to exist before operation, and TO exist after operation.
      // Pre-write (!exists) + Post-write (existsAfter) prevents re-using pre-existing report docs for replay increments.
      // The primary path since F1 is the trusted reportPhoto callable (enforceAppCheck, non-anonymous sign-in
      // required, 20 reports/hour/UID, transaction identical to the rules' path): this direct-write rule stays so
      // older installed app versions keep working; a later release denies it once adoption allows.
      allow update: if isAuthenticated()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportsCount'])
                    && request.resource.data.reportsCount == resource.data.reportsCount + 1
                    && !exists(/databases/$(database)/documents/spot_photos/$(photoId)/reports/$(request.auth.uid))
                    && existsAfter(/databases/$(database)/documents/spot_photos/$(photoId)/reports/$(request.auth.uid));

      allow delete: if false;

      // Per-user unique report tracking subcollection: report document ID = user UID.
      // A report document may ONLY be created as part of the atomic transaction that
      // increments the parent photo's reportsCount counter (see the parent update rule):
      // the parent photo must exist before the operation, its reportsCount must increase by
      // exactly one in this transaction, and the user's own report document must not exist
      // before it and must exist after it. Reporter UIDs are never exposed to anyone.
      match /reports/{userId} {
        allow read: if false; // Reporter UIDs are never exposed to anyone
        allow create: if isAuthenticated()
                      && userId == request.auth.uid
                      && request.resource.data.keys().hasOnly(['reporterUid', 'timestamp'])
                      && request.resource.data.reporterUid == request.auth.uid
                      && request.resource.data.timestamp is number
                      && get(/databases/$(database)/documents/spot_photos/$(photoId)).data.reportsCount is number
                      && getAfter(/databases/$(database)/documents/spot_photos/$(photoId)).data.reportsCount
                           == get(/databases/$(database)/documents/spot_photos/$(photoId)).data.reportsCount + 1
                      && !exists(/databases/$(database)/documents/spot_photos/$(photoId)/reports/$(userId))
                      && existsAfter(/databases/$(database)/documents/spot_photos/$(photoId)/reports/$(userId));
        allow update, delete: if false;
      }
    }

    match /shared_trips/{tripId} {
      // Public read ONLY by exact document ID while not expired (get only; list/query prohibited).
      allow get: if resource.data.expireAt is timestamp && resource.data.expireAt > request.time;
      allow list: if false;

      // Creation is only permitted through the trusted publishSharedTrip Cloud Function,
      // whose Admin SDK writes bypass these rules. Direct client creation is denied
      // because the rules language cannot validate list/map contents: there is no
      // iteration (the CEL all() macro is unsupported in this rules version) and the
      // 1000-expression evaluation cap forbids bounded explicit per-entry validation of
      // 50 waypoints (both verified empirically against the rules engine). The full
      // shared-trip schema is therefore enforced server-side in functions/sharedTrips.js.
      allow create: if false;

      // Shared trip links are immutable and read-only once created
      allow update, delete: if false;
    }

    // Idempotency records of the publishSharedTrip Cloud Function: each maps a
    // client-supplied requestId to the server-generated tripId of the published trip
    // and the publishing owner UID. Written exclusively by the trusted Admin SDK;
    // clients must never read, write, or enumerate them.
    match /shared_trip_publish_requests/{requestId} {
      allow read, write: if false;
    }

    // Server-side bookkeeping of the photo cleanup process: the resumable listing
    // cursor and the per-object deletion claims (which race-coordinate the reaper with
    // photo finalization). Written exclusively by the trusted Admin SDK; clients have
    // no legitimate access to internal cleanup state.
    match /photo_cleanup_state/{stateId} {
      allow read, write: if false;
    }

    // The server-written ownership index for public community documents
    // (community_tips, community_submissions, spot_photos): maps each document id to its
    // owner UID so the rules can enforce ownership (owner-only edits, no self-upvotes)
    // without publishing UIDs in the publicly readable documents. Written only by the
    // trusted callables through the Admin SDK; clients have no direct read or write
    // access — the rules get()/exists() calls that validate ownership bypass the read
    // permission by design (see communityOwnerUid above).
    match /ownership_index/{collectionId}/records/{recordId} {
      allow read, write: if false;
    }

    match /photo_cleanup_claims/{claimId} {
      allow read, write: if false;
    }
  }
}
