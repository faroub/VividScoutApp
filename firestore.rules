// Rate limiting and abuse prevention must be enforced via Firebase App Check in the Firebase Console.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(ownerUid) {
      return isAuthenticated() && request.auth.uid == ownerUid;
    }

    function isValidCoordinates(lat, lng) {
      return lat >= -90.0 && lat <= 90.0 && lng >= -180.0 && lng <= 180.0;
    }

    function isValidPhotoUri(uri) {
      return uri is string && (uri == '' || (uri.size() < 2048 && uri.matches('^https://.*')));
    }

    match /community_submissions/{submissionId} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasOnly([
                         'id', 'ownerUid', 'title', 'description', 'category', 'locationName',
                         'latitude', 'longitude', 'photoUri', 'userNotes', 'contributor', 'timestamp'
                       ])
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.id is string
                    && request.resource.data.id.size() <= 128
                    && request.resource.data.title is string
                    && request.resource.data.title.size() >= 2
                    && request.resource.data.title.size() <= 120
                    && request.resource.data.category is string
                    && request.resource.data.category.size() <= 32
                    && request.resource.data.latitude is number
                    && request.resource.data.longitude is number
                    && isValidCoordinates(request.resource.data.latitude, request.resource.data.longitude)
                    && isValidPhotoUri(request.resource.data.photoUri)
                    && request.resource.data.timestamp is number;

      allow update: if isOwner(resource.data.ownerUid)
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'id', 'ownerUid', 'title', 'description', 'category', 'locationName',
                         'latitude', 'longitude', 'photoUri', 'userNotes', 'contributor', 'timestamp'
                       ])
                    && request.resource.data.title is string
                    && request.resource.data.title.size() >= 2
                    && request.resource.data.title.size() <= 120
                    && request.resource.data.category is string
                    && request.resource.data.category.size() <= 32
                    && request.resource.data.latitude is number
                    && request.resource.data.longitude is number
                    && isValidCoordinates(request.resource.data.latitude, request.resource.data.longitude)
                    && isValidPhotoUri(request.resource.data.photoUri)
                    && request.resource.data.timestamp is number;

      allow delete: if false;
    }

    match /community_tips/{tipId} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasOnly([
                         'id', 'ownerUid', 'spotId', 'spotTitle', 'authorName', 'content',
                         'timestamp', 'isStatusUpdate', 'statusCategory', 'upvotes'
                       ])
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.id is string
                    && request.resource.data.id.size() <= 128
                    && request.resource.data.spotId is string
                    && request.resource.data.spotId.size() <= 128
                    && request.resource.data.content is string
                    && request.resource.data.content.size() >= 2
                    && request.resource.data.content.size() <= 500
                    && request.resource.data.timestamp is number;

      allow update: if isAuthenticated() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes'])
         && request.resource.data.upvotes == resource.data.upvotes + 1) ||
        (isOwner(resource.data.ownerUid)
         && request.resource.data.ownerUid == request.auth.uid
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'id', 'ownerUid', 'spotId', 'spotTitle', 'authorName', 'content',
              'timestamp', 'isStatusUpdate', 'statusCategory'
            ]))
      );

      allow delete: if false;
    }
  }
}
