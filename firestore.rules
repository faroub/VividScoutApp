// Rate limiting and abuse prevention must be enforced via Firebase App Check in the Firebase Console.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(ownerUid) {
      return isAuthenticated() && request.auth.uid == ownerUid;
    }

    function isValidCoordinates(lat, lng) {
      return lat >= -90.0 && lat <= 90.0 && lng >= -180.0 && lng <= 180.0;
    }

    function isValidPhotoUri(uri) {
      return uri is string && (uri == '' || (uri.size() < 2048 && uri.matches('^https://.*')));
    }

    match /community_submissions/{submissionId} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasOnly([
                         'id', 'ownerUid', 'title', 'description', 'category', 'locationName',
                         'latitude', 'longitude', 'photoUri', 'userNotes', 'contributor', 'timestamp'
                       ])
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.id is string
                    && request.resource.data.id.size() <= 128
                    && request.resource.data.title is string
                    && request.resource.data.title.size() >= 2
                    && request.resource.data.title.size() <= 120
                    && request.resource.data.category is string
                    && request.resource.data.category.size() <= 32
                    && request.resource.data.latitude is number
                    && request.resource.data.longitude is number
                    && isValidCoordinates(request.resource.data.latitude, request.resource.data.longitude)
                    && isValidPhotoUri(request.resource.data.photoUri)
                    && request.resource.data.timestamp is number;

      allow update: if isOwner(resource.data.ownerUid)
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'id', 'ownerUid', 'title', 'description', 'category', 'locationName',
                         'latitude', 'longitude', 'photoUri', 'userNotes', 'contributor', 'timestamp'
                       ])
                    && request.resource.data.title is string
                    && request.resource.data.title.size() >= 2
                    && request.resource.data.title.size() <= 120
                    && request.resource.data.category is string
                    && request.resource.data.category.size() <= 32
                    && request.resource.data.latitude is number
                    && request.resource.data.longitude is number
                    && isValidCoordinates(request.resource.data.latitude, request.resource.data.longitude)
                    && isValidPhotoUri(request.resource.data.photoUri)
                    && request.resource.data.timestamp is number;

      allow delete: if false;
    }

    match /community_tips/{tipId} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasOnly([
                         'id', 'ownerUid', 'spotId', 'spotTitle', 'authorName', 'content',
                         'timestamp', 'isStatusUpdate', 'statusCategory', 'legacyUpvotes', 'upvotes'
                       ])
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.id is string
                    && request.resource.data.id.size() <= 128
                    && request.resource.data.spotId is string
                    && request.resource.data.spotId.size() <= 128
                    && request.resource.data.content is string
                    && request.resource.data.content.size() >= 2
                    && request.resource.data.content.size() <= 500
                    && request.resource.data.timestamp is number
                    && request.resource.data.legacyUpvotes is number
                    && request.resource.data.upvotes == 0;

      // Allow +1 upvote increment only when a corresponding vote document is created in the same request,
      // OR owner-only tip retries (which CANNOT modify upvotes or legacyUpvotes)
      allow update: if isAuthenticated() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes'])
         && request.resource.data.upvotes == resource.data.upvotes + 1
         && existsAfter(/databases/$(database)/documents/community_tips/$(tipId)/votes/$(request.auth.uid))) ||
        (isOwner(resource.data.ownerUid)
         && request.resource.data.ownerUid == request.auth.uid
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'id', 'ownerUid', 'spotId', 'spotTitle', 'authorName', 'content',
              'timestamp', 'isStatusUpdate', 'statusCategory', 'legacyUpvotes'
            ]))
      );

      allow delete: if false;

      // Per-user vote tracking subcollection: a user may read or create only their own vote document
      match /votes/{userId} {
        allow read: if isAuthenticated() && userId == request.auth.uid;
        allow create: if isAuthenticated()
                      && userId == request.auth.uid
                      && request.resource.data.keys().hasOnly(['uid', 'timestamp'])
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.timestamp is number;
        allow update, delete: if false;
      }
    }

    match /spot_photos/{photoId} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasOnly(['id', 'spotId', 'photoUrl', 'ownerUid', 'reportsCount', 'timestamp'])
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.reportsCount == 0;

      // Allow +1 reportsCount increment ONLY when a corresponding unique report document is created in the same request
      allow update: if isAuthenticated()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportsCount'])
                    && request.resource.data.reportsCount == resource.data.reportsCount + 1
                    && existsAfter(/databases/$(database)/documents/spot_photos/$(photoId)/reports/$(request.auth.uid));

      allow delete: if false;

      // Per-user unique report tracking subcollection: report document ID = user UID
      match /reports/{userId} {
        allow read: if false; // Reporter UIDs are never exposed to anyone
        allow create: if isAuthenticated()
                      && userId == request.auth.uid
                      && request.resource.data.keys().hasOnly(['reporterUid', 'timestamp'])
                      && request.resource.data.reporterUid == request.auth.uid
                      && request.resource.data.timestamp is number;
        allow update, delete: if false;
      }
    }

    match /shared_trips/{tripId} {
      // Public read ONLY by exact document ID (get rule only; list/query prohibited)
      allow get: if true;
      allow list: if false;

      // Create allowed for authenticated users without user tracking fields
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasOnly(['id', 'title', 'spots', 'createdAt', 'expireAt'])
                    && request.resource.data.id == tripId
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 120
                    && request.resource.data.createdAt is number
                    && request.resource.data.expireAt is number;

      // Shared trip links are immutable and read-only once created
      allow update, delete: if false;
    }
  }
}
